# copy to /etc/modus.env and: sudo chmod 600 /etc/modus.env
# these override config/sources.json and keep secrets out of git.
DISCORD_TOKEN=your-bot-token
DISCORD_CHANNEL_ID=your-drops-channel-id
DISCORD_USER_ID=your-own-discord-user-id
CLAUDE_API_KEY=your-anthropic-api-key
# optional overrides:
# CLAUDE_MODEL=claude-sonnet-5
# SCORE_THRESHOLD=4
# SCAN_INTERVAL_MINUTES=15
