{
  "name": "modus",
  "version": "0.1.0",
  "description": "Watches internship feeds, scores new roles against your profile with a local model, and posts the good ones to Discord with a button to draft an application in Dossier. Runs on your own machine.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsc && node --env-file=.env dist/index.js",
    "connect-dossier": "node --env-file=.env dist/dossier/connect.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "discord.js": "^14.16.3",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
